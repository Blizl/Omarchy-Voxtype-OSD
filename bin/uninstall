#!/usr/bin/env bash
#
# bin/uninstall - Clean Uninstaller for VoxType OSD Omarchy Plugin
#
# Restores previous VoxType configuration, removes installed Quickshell
# components, and restores service state.

set -euo pipefail

PLUGIN_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"

# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/transaction.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/checkpoint.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/voxtype-config.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/qml-installer.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/service.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/keybindings.sh"

STATE_ROOT="${BLIZL_VOXTYPE_OSD_STATE_DIR:-$HOME/.local/state/blizl.voxtype-osd}"
INSTALL_FILE="$STATE_ROOT/install.json"
SKIP_SERVICE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-service)
      SKIP_SERVICE=true
      export BLIZL_VOXTYPE_SKIP_SERVICE=true
      shift
      ;;
    -h | --help)
      echo "Usage: bin/uninstall [--skip-service]"
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

remove_keybindings() {
  local file
  file="$(keybindings_file)"
  if keybindings_installed "$file"; then
    echo "Removing VoxType panel keybindings from $file..."
    keybindings_remove "$file"
    keybindings_reload
  fi
}

CONFIG_FILE="$(voxtype_config_default_path)"
QUICKSHELL_DIR="$(qml_target_dir)"

if [[ ! -f "$INSTALL_FILE" ]]; then
  echo "No blizl.voxtype-osd installation record found. Running clean-up..."
  qml_uninstall "$QUICKSHELL_DIR"
  voxtype_config_disable_osd "$CONFIG_FILE" || true
  remove_keybindings
  service_restart_if_active "voxtype.service" || true
  echo "VoxType OSD HUD has been cleanly uninstalled."
  exit 0
fi

# Restore from the ORIGINAL pre-install baseline (carried across re-runs of setup)
transaction_dir="$(jq -r '.baselineTransaction // .transaction // ""' "$INSTALL_FILE")"
service_was_active="$(jq -r '.serviceWasActive // false' "$INSTALL_FILE")"

echo "Uninstalling VoxType OSD HUD..."

restore_from_baseline() {
  local base="$1" state target
  while IFS=$'\t' read -r state target; do
    [[ -n "$target" ]] || continue
    case "$target" in
      "$CONFIG_FILE")
        # Only the [osd] section is ours; keep the user's other settings as they are now
        if [[ "$state" == present ]]; then
          voxtype_config_restore_osd_section "$CONFIG_FILE" "$base/files/${target#/}" || true
        else
          voxtype_config_restore_osd_section "$CONFIG_FILE" "" || true
        fi
        ;;
      "$INSTALL_FILE") ;; # removed below
      *)
        # Quickshell dir & anything else: byte-for-byte restore / removal
        transaction_safe_target "$target" || {
          echo "Refusing unsafe rollback target: $target" >&2
          continue
        }
        if [[ "$state" == present ]]; then
          transaction_remove_target "$target"
          mkdir -p -- "$(dirname -- "$target")"
          cp -a --reflink=auto -- "$base/files/${target#/}" "$target"
        else
          transaction_remove_target "$target"
        fi
        ;;
    esac
  done <"$base/targets.tsv"
}

if [[ -n "$transaction_dir" && -f "$transaction_dir/targets.tsv" ]]; then
  echo "Restoring pre-install state from $transaction_dir..."
  restore_from_baseline "$transaction_dir"
else
  echo "No transaction record found; removing installed files directly..."
  qml_uninstall "$QUICKSHELL_DIR"
  voxtype_config_disable_osd "$CONFIG_FILE" || true
fi

# Remove our keybinding block (user edits elsewhere in the file are preserved)
remove_keybindings

# Clean up install record
rm -f -- "$INSTALL_FILE"

# Restart voxtype service if it was active
if [[ "$SKIP_SERVICE" != true && "$service_was_active" == "true" ]]; then
  echo "Restarting voxtype.service..."
  service_restart_if_active "voxtype.service" || true
fi

echo "VoxType OSD HUD has been cleanly uninstalled."
