#!/usr/bin/env bash
#
# bin/setup - Safe Installer for VoxType OSD Omarchy Plugin
#
# Installs Quickshell OSD HUD components and configures VoxType to use
# the Quickshell frontend. Includes user confirmation, automated backups,
# atomic rollback on error, and idempotency.

set -euo pipefail

PLUGIN_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"

# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/transaction.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/checkpoint.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/voxtype-config.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/qml-installer.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/service.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/keybindings.sh"

STATE_ROOT="${BLIZL_VOXTYPE_OSD_STATE_DIR:-$HOME/.local/state/blizl.voxtype-osd}"
CONFIG_FILE="$(voxtype_config_default_path)"
QUICKSHELL_DIR="$(qml_target_dir)"
INSTALL_FILE="$STATE_ROOT/install.json"

NON_INTERACTIVE=false
SKIP_SERVICE=false
DRY_RUN=false
SKIP_KEYBINDINGS=false
OVERRIDE_KEYBINDINGS=false
KEYBINDINGS_INSTALLED=false
CREATED_TRANSACTION=false
COMMITTED=false

say() { printf '%s\n' "$*"; }
fail() {
  printf 'setup: %s\n' "$*" >&2
  exit 1
}

show_help() {
  cat <<USAGE
Usage: bin/setup [OPTIONS]

Installs the VoxType Quickshell OSD HUD and configures VoxType to use it.

Options:
  -y, --yes          Proceed automatically without interactive prompts
  --skip-service     Skip systemd service restarts (useful for containers/testing)
  --dry-run          Show planned changes without modifying disk
  --skip-keybindings Do not offer to add SUPER+E / SUPER+M panel keybindings
  --override-keybindings
                     Replace existing SUPER+E / SUPER+M bindings without asking
                     (non-interactive runs otherwise leave conflicting keys alone)
  -h, --help         Show this help message
USAGE
}

confirm() {
  local prompt="$1"
  local default="${2:-yes}"
  local answer suffix

  if [[ "$NON_INTERACTIVE" == true || -n "${BLIZL_VOXTYPE_CONFIRM:-}" ]]; then
    return 0
  fi
  [[ -t 0 ]] || return 0
  [[ "$default" == yes ]] && suffix='[Y/n]' || suffix='[y/N]'
  read -r -p "$prompt $suffix " answer
  answer="${answer:-$default}"
  [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
}

# Like confirm(), but non-interactive runs get the *default* answer instead of "yes"
confirm_default() {
  local prompt="$1" default="${2:-no}"
  if [[ "$NON_INTERACTIVE" == true || -n "${BLIZL_VOXTYPE_CONFIRM:-}" || ! -t 0 ]]; then
    [[ "$default" == yes ]]
    return
  fi
  confirm "$prompt" "$default"
}

cleanup() {
  local status=$?
  if ((status != 0)) && [[ "$CREATED_TRANSACTION" == true && "$COMMITTED" != true ]]; then
    say "Setup encountered an error; rolling back changes..."
    if [[ "$KEYBINDINGS_INSTALLED" == true ]]; then
      keybindings_remove "$(keybindings_file)" || true
    fi
    transaction_restore "$TRANSACTION_DIR" || {
      printf 'Error: Rollback failed.\n' >&2
    }
  fi
}

trap cleanup EXIT

# Parse CLI flags
while [[ $# -gt 0 ]]; do
  case "$1" in
    -y | --yes)
      NON_INTERACTIVE=true
      shift
      ;;
    --skip-service)
      SKIP_SERVICE=true
      export BLIZL_VOXTYPE_SKIP_SERVICE=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --skip-keybindings)
      SKIP_KEYBINDINGS=true
      shift
      ;;
    --override-keybindings)
      OVERRIDE_KEYBINDINGS=true
      shift
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

if [[ -n "${BLIZL_VOXTYPE_NONINTERACTIVE:-}" && "${BLIZL_VOXTYPE_NONINTERACTIVE}" == "true" ]]; then
  NON_INTERACTIVE=true
fi

say "========================================================"
say "      VoxType OSD HUD - Quickshell Plugin Setup        "
say "========================================================"
say ""

# Display status
say "Target configuration file: $CONFIG_FILE"
say "Target Quickshell directory: $QUICKSHELL_DIR"
say ""

if [[ -f "$CONFIG_FILE" ]]; then
  voxtype_config_summary "$CONFIG_FILE"
  say ""
fi

if [[ "$DRY_RUN" == true ]]; then
  say "[Dry-run] Planned actions:"
  say "  1. Back up $CONFIG_FILE and $QUICKSHELL_DIR"
  say "  2. Install Quickshell OSD components into $QUICKSHELL_DIR"
  say "  3. Set [osd] frontend = 'quickshell' in $CONFIG_FILE"
  say "  4. Restart voxtype.service if currently active"
  say "  5. Offer SUPER+E / SUPER+M keybindings in $(keybindings_file)"
  exit 0
fi

# Confirmation prompt
if ! confirm "Proceed with VoxType OSD HUD installation and configuration?"; then
  say "Setup cancelled by user."
  exit 0
fi

say "Starting installation..."

# Initialize transaction and checkpoint
mkdir -p -- "$STATE_ROOT"
transaction_begin "$STATE_ROOT"
CREATED_TRANSACTION=true

# Back up targets
transaction_backup "$CONFIG_FILE"
transaction_backup "$QUICKSHELL_DIR"
transaction_backup "$INSTALL_FILE"

# Create snapshot checkpoint
checkpoint_id="$(checkpoint_create || printf 'none')"

# 1. Install QML components
say "Installing Quickshell components to $QUICKSHELL_DIR..."
qml_install "$PLUGIN_ROOT" "$QUICKSHELL_DIR"

# 2. Update config.toml
say "Configuring VoxType OSD settings in $CONFIG_FILE..."
voxtype_config_configure_osd "$CONFIG_FILE" "true" "quickshell" "bottom-center" "320" "48" "80" "0.96" "12.0"

# 3. Restart service if active
service_was_active=false
if service_is_active "voxtype.service"; then
  service_was_active=true
  if [[ "$SKIP_SERVICE" != true ]]; then
    say "Restarting voxtype.service..."
    service_restart_if_active "voxtype.service" || true
  fi
fi

# 4. Optional panel keybindings (Engine Picker / Meeting Controls)
install_keybindings() {
  local file engine=true meeting=true engine_override=false meeting_override=false in_use
  file="$(keybindings_file)"

  [[ "$SKIP_KEYBINDINGS" == true ]] && return 0
  if ! keybindings_supported; then
    say "Skipping keybindings: $(dirname -- "$file") not found (not an Omarchy/Hyprland setup?)"
    return 0
  fi

  say ""
  if ! confirm "Add keybindings ${KEYBIND_ENGINE_KEYS} (Engine Picker) and ${KEYBIND_MEETING_KEYS} (Meeting Controls) to $file?"; then
    say "Skipping keybindings. You can add them later:"
    say "  o.bind(\"${KEYBIND_ENGINE_KEYS}\", \"VoxType engine picker\", \"${KEYBIND_ENGINE_CMD}\")"
    say "  o.bind(\"${KEYBIND_MEETING_KEYS}\", \"VoxType meeting controls\", \"${KEYBIND_MEETING_CMD}\")"
    return 0
  fi

  if in_use="$(keybinding_in_use "$KEYBIND_ENGINE_KEYS" "$file")"; then
    say "${KEYBIND_ENGINE_KEYS} is already bound: ${in_use}"
    if [[ "$OVERRIDE_KEYBINDINGS" == true ]] || confirm_default "Override ${KEYBIND_ENGINE_KEYS} with the VoxType Engine Picker?" no; then
      engine_override=true
    else
      engine=false
      say "Leaving ${KEYBIND_ENGINE_KEYS} unchanged (re-run with --override-keybindings to replace it)."
    fi
  fi
  if in_use="$(keybinding_in_use "$KEYBIND_MEETING_KEYS" "$file")"; then
    say "${KEYBIND_MEETING_KEYS} is already bound: ${in_use}"
    if [[ "$OVERRIDE_KEYBINDINGS" == true ]] || confirm_default "Override ${KEYBIND_MEETING_KEYS} with the VoxType Meeting Controls?" no; then
      meeting_override=true
    else
      meeting=false
      say "Leaving ${KEYBIND_MEETING_KEYS} unchanged (re-run with --override-keybindings to replace it)."
    fi
  fi

  if [[ "$engine" == true || "$meeting" == true ]]; then
    keybindings_install "$file" "$engine" "$engine_override" "$meeting" "$meeting_override"
    KEYBINDINGS_INSTALLED=true
    keybindings_reload
    [[ "$engine" == true ]] && say "Bound ${KEYBIND_ENGINE_KEYS} -> Engine Picker"
    [[ "$meeting" == true ]] && say "Bound ${KEYBIND_MEETING_KEYS} -> Meeting Controls"
  fi
  return 0
}
install_keybindings

# 5. Save installation record
cat <<EOF >"$INSTALL_FILE"
{
  "version": 1,
  "installedAt": "$(date -u +%Y%m%dT%H%M%SZ)",
  "transaction": "$TRANSACTION_DIR",
  "checkpointId": "$checkpoint_id",
  "configFile": "$CONFIG_FILE",
  "quickshellDir": "$QUICKSHELL_DIR",
  "serviceWasActive": $service_was_active,
  "keybindingsInstalled": $KEYBINDINGS_INSTALLED
}
EOF

COMMITTED=true
say ""
say "========================================================"
say " VoxType OSD HUD setup completed successfully!"
say "========================================================"
say ""
say "Features enabled:"
say "  - Modern floating capsule HUD with Omarchy Nord styling"
say "  - Real-time animated equalizer bars with audio peak detection"
say "  - State indicators for recording, streaming, and transcription"
say "  - Elapsed timer & VAD halo indicators"
if [[ "$KEYBINDINGS_INSTALLED" == true ]]; then
  say "  - ${KEYBIND_ENGINE_KEYS}: Engine Picker, ${KEYBIND_MEETING_KEYS}: Meeting Controls"
fi
say ""
